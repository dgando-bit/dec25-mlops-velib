# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Template des variables d'environnement
# ─────────────────────────────────────────────────────────────────────────────
# Copier ce fichier vers .env (jamais commité) et renseigner les valeurs.
#   cp .env.example .env
#
# Ce fichier .env est lu automatiquement par shared/config.py au démarrage
# de chaque service.
# ─────────────────────────────────────────────────────────────────────────────

# ── DOCKER COMPOSE ────────────────────────────────────────────────────────────
# Préfixe de nommage des conteneurs et volumes générés par Compose.
# Changer cette valeur pour isoler plusieurs instances du projet sur la même
# machine (ex. dev local, test de reproductibilité, CI).
COMPOSE_PROJECT_NAME=velib

# ── HuggingFace ──────────────────────────────────────────────────────────────
# Identifiant du repo HF Datasets (format user/repo)
HF_REPO=voroman/velib-ml-data

# Token HF — Read suffit si le repo est public.
# Génération : https://huggingface.co/settings/tokens
HF_TOKEN="hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Préfixe des fichiers raw produits par le collector HF Space
HF_FILE_PREFIX=dataset_velib_raw_

# Si True, ignore le cache HF local (re-télécharge tout à chaque exécution).
# À passer à False quand le dataset dépassera ~2 Go.
HF_FORCE_DOWNLOAD=true

# Nombre de tentatives en cas d'erreur réseau transitoire (429, 5xx, timeout)
HF_MAX_RETRIES=3
HF_RETRY_INITIAL_WAIT_S=5

# ── DOSSIERS DATA (chemins relatifs au repo, ou absolus) ─────────────────────
# Décommenter pour surcharger les valeurs par défaut de shared/config.py
# RAW_DATA_DIR=data/raw
# INTERIM_DATA_DIR=data/interim
# PROCESSED_DATA_DIR=data/processed
# PLOTS_DIR=data/outputs/plots

# ── ML — paramètres d'entraînement ───────────────────────────────────────────
RANDOM_STATE=42
TEST_SIZE=0.20
MIN_VARIANCE=0.5

# ── LOGGING ──────────────────────────────────────────────────────────────────
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# 'text' (humain) ou 'json' (machine, pour Loki/OpenTelemetry)
LOG_FORMAT=text
JUPYTER_TOKEN=mon-token-secret


# ML
ML_MODEL_STAGE=staging
API_MODEL_STAGE=production

# BASE DE DONNÉES MLFLOW (PostgreSQL)
MLFLOW_DB=mlflow_db
MLFLOW_USER=user
MLFLOW_PASSWORD=password
MLFLOW_HOST=mlflow-db

MLFLOW_PORT=5000

MLFLOW_TRACKING_URI=http://mlflow-server:5000
MLFLOW_MODEL_NAME=velib-metropole-model

# ── MONITORING ────────────────────────────────────────────────────────────────
# Mot de passe admin Grafana (défaut : admin si non défini)
GRAFANA_PASSWORD=admin
