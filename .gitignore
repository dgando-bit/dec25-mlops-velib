# ─── Secrets ─────────────────────────────────────────────────────────────────
.env
.env.local
*.pem
*.key

# ─── Données (versionnées par DVC, pas par Git) ──────────────────────────────
data/raw/*.parquet
data/raw/*.csv
data/raw/.hf_cache/
data/interim/*.parquet
data/processed/*.parquet
data/outputs/

