# ─── Secrets ─────────────────────────────────────────────────────────────────
.env
.env.local
*.pem
*.key

# ─── Données (versionnées par DVC, pas par Git) ──────────────────────────────
data/raw/*.parquet
data/raw/*.csv
data/raw/.hf_cache/
data/interim/*.parquet
data/processed/*.parquet
data/outputs/*

# Exceptions : metrics et plots (versionnés Git pour DVC plots/metrics + diff PR)
!data/outputs/metrics.json
!data/outputs/feature_importance.png
!data/outputs/residuals_distribution.png
!data/outputs/predictions_vs_actual.png

# Logs d'exécution (regénérés à chaque run)
data/raw/.snapshots.log
data/interim/.cleaning.log
data/processed/.features.log
data/processed/build_metadata.json
data/processed/stations_geo.parquet



# ─── DVC interne ────────────────────────────────────────────────────────────
.dvc/cache/
.dvc/tmp/
.dvc/config.local

# ─── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# ─── ML ─────────────────────────────────────────────────────────────────────
mlruns/
mlartifacts/
*.joblib
*.pkl
mlflow.db

# ─── IDE ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
/mlartifacts
/mlruns
